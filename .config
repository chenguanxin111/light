# Generated by Kconfig

#
# Boards Options
#
CONFIG_BOARD_NMAE="CSK5060M"

#
# ARCH: riscv32
#
# CONFIG_BOARD_PACKAGE_SOP08 is not set
CONFIG_BOARD_PACKAGE_SOP16=y
# CONFIG_BOARD_PACKAGE_SOP24 is not set
# CONFIG_BOARD_PACKAGE_SOP32 is not set
# CONFIG_BOARD_PACKAGE_SOP48 is not set

#
# NorFlash
#
# CONFIG_BOARD_FLASH_1MB is not set
CONFIG_BOARD_FLASH_2MB=y
# CONFIG_BOARD_FLASH_SPI is not set
# CONFIG_BOARD_FLASH_DPI is not set
CONFIG_BOARD_FLASH_QPI=y
# end of NorFlash

#
# Toolchain
#
# CONFIG_TOOLCHAIN_V10 is not set
CONFIG_TOOLCHAIN_V13=y
CONFIG_TOOLCHAIN_PREFIX="riscv64-unknown-elf-"
# CONFIG_TOOLCHAIN_OPTIMIZE_O0 is not set
CONFIG_TOOLCHAIN_OPTIMIZE_OS=y
CONFIG_TOOLCHAIN_OPTIMIZE="-Os"
CONFIG_TOOLCHAIN_BUILDIR="build"
# end of Toolchain
# end of Boards Options

#
# Modules Options
#
CONFIG_MODULE_BSP=y
CONFIG_MODULE_DRIVER=y
# CONFIG_MODULE_BTRACE is not set
# CONFIG_MODULE_CJSON is not set
CONFIG_MODULE_CRC32=y
CONFIG_CRC32_DEFAULT_POLYNOM=0x04C11DB7
CONFIG_CRC32_USE_STATIC_TABLE=y
CONFIG_MODULE_FREERTOS=y
CONFIG_MODULE_SHELL=y
CONFIG_SHELL_NAME="shell"
CONFIG_SHELL_PARAM_MAX=3
CONFIG_SHELL_HISTORY_MAX=2
CONFIG_SHELL_LINE_LIMIT=500
CONFIG_SHELL_TXBUF_SIZE=512
CONFIG_SHELL_RXBUF_SIZE=32
CONFIG_SHELL_COLOR_ENABLE=y
# CONFIG_SHELL_NEWLINE_CRLF is not set
# CONFIG_SHELL_NEWLINE_CR is not set
CONFIG_SHELL_NEWLINE_LF=y
# CONFIG_SHELL_DEBUG_LEVEL_NONE is not set
# CONFIG_SHELL_DEBUG_LEVEL_ERROR is not set
# CONFIG_SHELL_DEBUG_LEVEL_WARN is not set
# CONFIG_SHELL_DEBUG_LEVEL_INFO is not set
CONFIG_SHELL_DEBUG_LEVEL_DEBUG=y
# CONFIG_SHELL_DEBUG_LEVEL_VERB is not set
CONFIG_SHELL_DEBUG_LEVEL=4
CONFIG_MODULE_TINYNVS=y
CONFIG_TNVS_ITEMSIZE=28
# CONFIG_TNVS_SHELL is not set
# CONFIG_TNVS_SR_WREN is not set

#
# Libraries Options
#
CONFIG_ALGO_LUNA_ENABLE=y
CONFIG_ALGO_MINIESR_ENABLE=y
# CONFIG_MP3DEC_ENABLE is not set
# end of Libraries Options
# end of Modules Options

#
# Components Options
#
CONFIG_RESMGR_ENABLE=y
CONFIG_RESMGR_NAME="xres"
CONFIG_RESMGR_FIXED_LOCATION=y
# CONFIG_RESMGR_AUTO_INCLUDED is not set
CONFIG_RESMGR_FIXED_ADDRESS=0x30080000
CONFIG_RESMGR_TAGNAME=0x594C4649
CONFIG_RESMGR_DATCHK=y
CONFIG_RESMGR_FINDBYID=y
# CONFIG_RESMGR_FINDBYTAG is not set
CONFIG_RESMGR_BASEID=y
CONFIG_RESMGR_BASE_APPINFO=0
CONFIG_RESMGR_BASE_APPCONF=1
CONFIG_RESMGR_BASE_OTPTAB=2
CONFIG_RESMGR_BASE_ALGORES=3
CONFIG_RESMGR_BASE_SOUNDRES=10
CONFIG_GPIO_ENABLE=y
CONFIG_GPIO_NAME="gpio"
CONFIG_JTAG_ENABLE=y
CONFIG_CLOCK_ENABLE=y
CONFIG_CLOCK_NAME="clock"
CONFIG_CLOCK_CORE=y
# CONFIG_CLOCK_CORE_300M is not set
CONFIG_CLOCK_CORE_240M=y
# CONFIG_CLOCK_CORE_200M is not set
# CONFIG_CLOCK_CORE_150M is not set
# CONFIG_CLOCK_CORE_133M is not set
# CONFIG_CLOCK_CORE_120M is not set
# CONFIG_CLOCK_CORE_100M is not set
CONFIG_CLOCK_FLASH=y
# CONFIG_CLOCK_FLASH_120M is not set
CONFIG_CLOCK_FLASH_100M=y
# CONFIG_CLOCK_FLASH_086M is not set
# CONFIG_CLOCK_FLASH_080M is not set

#
# Enable UART Modules
#
CONFIG_UART0_FOR_TRACE=y
# CONFIG_UART1_FOR_TRACE is not set
CONFIG_TRACE_ENABLE=y
CONFIG_TRACE_NAME="trace"
CONFIG_TRACE_UART0=y
CONFIG_TRACE_BAUD=921600
CONFIG_TRACE_SEND=y
CONFIG_TRACE_RECV=y
CONFIG_UPROT_ENABLE=y
CONFIG_UPROT_NAME="uprot"
CONFIG_UPROT_UART1=y
CONFIG_UPROT_BAUD=9600
CONFIG_UPROT_SEND=y
CONFIG_UPROT_RECV=y
CONFIG_UPROT_RXFIFO_DEPTH=32
CONFIG_UPRPT_RXFIFO_BLKCNT=2
# end of Enable UART Modules

CONFIG_AADC_ENABLE=y
CONFIG_AADC_NAME="aadc"
CONFIG_AADC_GAIN=36
CONFIG_AADC_CAPOC=y
# CONFIG_AADC_CAPEX is not set
CONFIG_AADC_HPF=y
CONFIG_AADC_DIFF=y
CONFIG_CLSD_ENABLE=y
CONFIG_CLSD_NAME="clsd"
CONFIG_I2SO_ENABLE=y
CONFIG_I2SO_NAME="i2so"
# CONFIG_SPI_ENABLE is not set
CONFIG_TNVS_ENABLE=y
CONFIG_TNVS_NAME="tnvs"
CONFIG_TNVS_DEFID=2
CONFIG_XWDT_ENABLE=y
CONFIG_XWDT_NAME="xwdt"
CONFIG_DMAC_ENABLE=y
CONFIG_DMAC_NAME="dmac"
# end of Components Options

#
# Application Options
#
CONFIG_ALGO_ENABLE=y
CONFIG_ALGO_NAME="algo"
# CONFIG_TESTING_ENABLE is not set
# end of Application Options
